{
  "name": "@nf/api",
  "version": "0.1.0",
  "private": true,
  "description": "Neural Frontier control-plane API (NestJS modular monolith).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.1",
    "@nestjs/core": "12.4.1",
    "@nestjs/platform-express": "12.4.1",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nf/contracts": "0.1.0",
    "@nf/db": "0.1.0",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.16",
    "nestjs-pino": "5.3.1",
    "openid-client": "6.8.9",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.1",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
