# /etc/neural-frontier/api.env — root:neural 0640. Generated by scripts/install.sh.
# Never commit real values.
NODE_ENV=production
HOST=127.0.0.1
PORT=3401
LOG_LEVEL=info
# The deployed commit, read at start-up from the release being served.
NF_RELEASE_FILE=/license_monitoring/neural-frontier/current/RELEASE

DATABASE_URL=mysql://nf_app:CHANGE_ME@127.0.0.1:3306/neural_frontier?connectionLimit=20&allowPublicKeyRetrieval=true
REDIS_URL=redis://nf:CHANGE_ME@127.0.0.1:6379/0

# Public origin users type into the browser.
NF_PUBLIC_URL=https://192.168.197.100:8643
NF_SESSION_SECRET=CHANGE_ME_64_RANDOM_CHARS
NF_COOKIE_SECURE=true
NF_SESSION_IDLE_MINUTES=30
NF_SESSION_ABSOLUTE_HOURS=12
NF_TRUST_PROXY=loopback

# Single sign-on (OIDC). Leave empty until the identity provider is chosen; sign-in then
# shows "SSO not configured" instead of failing obscurely.
NF_OIDC_ISSUER=
NF_OIDC_CLIENT_ID=
NF_OIDC_CLIENT_SECRET=
NF_OIDC_REQUIRE_EMAIL_VERIFIED=true
NF_AUTO_PROVISION=true

NF_API_DOCS=false

# 32 random bytes, base64. Encrypts connector credentials (AES-256-GCM). Generated once by
# install.sh and kept in secrets.env. Losing it means re-entering connector secrets; back it
# up with backup.key.
NF_DATA_KEY=
# Background worker (dist/worker.js) — same env file as the API.
NF_WORKER_CONCURRENCY=4
NF_WORKER_TENANT_CONCURRENCY=2
