// Neural Frontier — operational database (MySQL 8.4 LTS).
//
// Conventions (see docs/architecture/data-model.md):
// - Primary keys are UUIDv7 (time-ordered, index-friendly, partition-friendly).
// - Every tenant-owned table carries `tenantId`, and every secondary index leads with it.
//   The tenant guard in src/tenant-guard.ts refuses queries that omit it.
// - Mutable aggregates carry `version` for optimistic concurrency.
// - No credentials are stored here. Session tokens are stored only as SHA-256 hashes.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

enum TenantStatus {
  active
  suspended
}

enum IdentityStatus {
  active
  suspended
}

enum AuditOutcome {
  success
  failure
  denied
}

model Tenant {
  id        String       @id @default(uuid(7)) @db.Char(36)
  slug      String       @unique @db.VarChar(63)
  name      String       @db.VarChar(200)
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @db.DateTime(3)
  updatedAt DateTime     @updatedAt @db.DateTime(3)
  version   Int          @default(0)

  domains         TenantDomain[]
  identities      Identity[]
  roles           Role[]
  roleAssignments RoleAssignment[]
  sessions        Session[]
  auditEvents     AuditEvent[]
  idempotencyKeys IdempotencyKey[]

  connectors              Connector[]
  syncRuns                SyncRun[]
  directoryUsers          DirectoryUser[]
  directoryGroups         DirectoryGroup[]
  directoryMemberships    DirectoryMembership[]
  jobs                    Job[]
  servicePrincipals       ServicePrincipal[]
  servicePrincipalSecrets ServicePrincipalSecret[]
  identityProvider        TenantIdentityProvider?
  scimTokens              ScimToken[]
  servers                 Server[]
  agentEnrollmentKeys     AgentEnrollmentKey[]

  @@map("tenants")
}

/// Email domains whose verified users sign in to this tenant.
model TenantDomain {
  id         String    @id @default(uuid(7)) @db.Char(36)
  tenantId   String    @db.Char(36)
  domain     String    @unique @db.VarChar(253)
  verifiedAt DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

model Identity {
  id           String         @id @default(uuid(7)) @db.Char(36)
  tenantId     String         @db.Char(36)
  email        String         @db.VarChar(320)
  displayName  String         @db.VarChar(200)
  status       IdentityStatus @default(active)
  /// OIDC issuer + subject are bound on first sign-in; later sign-ins match on them, not on email.
  oidcIssuer   String?        @db.VarChar(512)
  oidcSubject  String?        @db.VarChar(255)
  /// SCIM `externalId` from the provisioning client (e.g. the Entra object id).
  scimExternalId String?      @db.VarChar(255)
  /// True once a SCIM client created or claimed this identity: its lifecycle is driven from there.
  scimManaged    Boolean      @default(false)
  lastSignInAt DateTime?      @db.DateTime(3)
  createdAt    DateTime       @default(now()) @db.DateTime(3)
  updatedAt    DateTime       @updatedAt @db.DateTime(3)
  version      Int            @default(0)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[] @relation("assignee")
  grantsMade      RoleAssignment[] @relation("grantor")
  sessions        Session[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@unique([oidcIssuer, oidcSubject])
  @@unique([tenantId, scimExternalId])
  @@index([tenantId, status])
  @@index([tenantId, displayName])
  @@map("identities")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Char(36)
  tenantId    String   @db.Char(36)
  key         String   @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String   @db.VarChar(500)
  builtIn     Boolean  @default(false)
  /// Array of permission keys from @nf/contracts PERMISSIONS. Validated on read.
  permissions Json
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)
  version     Int      @default(0)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments RoleAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("roles")
}

model RoleAssignment {
  id          String   @id @default(uuid(7)) @db.Char(36)
  tenantId    String   @db.Char(36)
  identityId  String   @db.Char(36)
  roleId      String   @db.Char(36)
  grantedById String?  @db.Char(36)
  reason      String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Composite keys: an assignment can only join an identity and a role of the SAME tenant.
  identity  Identity  @relation("assignee", fields: [tenantId, identityId], references: [tenantId, id], onDelete: Cascade)
  role      Role      @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  grantedBy Identity? @relation("grantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([identityId, roleId])
  @@index([tenantId, roleId])
  @@index([tenantId, identityId])
  @@map("role_assignments")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Char(36)
  tenantId      String    @db.Char(36)
  identityId    String    @db.Char(36)
  /// SHA-256 of the opaque session token. The token itself is never stored.
  tokenHash     Bytes     @unique @db.Binary(32)
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.VarChar(512)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  lastSeenAt    DateTime  @default(now()) @db.DateTime(3)
  idleExpiresAt DateTime  @db.DateTime(3)
  expiresAt     DateTime  @db.DateTime(3)
  revokedAt     DateTime? @db.DateTime(3)
  /// Provider the session signed in through ("global" | "tenant:<id>"), for single sign-out.
  authProvider  String?   @db.VarChar(80)
  /// The ID token, sealed with NF_DATA_KEY, sent back as id_token_hint on sign-out.
  idTokenSealed Bytes?    @db.VarBinary(8192)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [tenantId, identityId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, identityId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Append-only. The application database user has no UPDATE or DELETE grant on this table
/// in production (see deploy/oracle-linux/mysql/provision.sql).
model AuditEvent {
  id          String       @id @default(uuid(7)) @db.Char(36)
  /// Null only for platform events that cannot be attributed to a tenant (e.g. unknown domain).
  tenantId    String?      @db.Char(36)
  occurredAt  DateTime     @default(now()) @db.DateTime(3)
  action      String       @db.VarChar(64)
  outcome     AuditOutcome
  actorId     String?      @db.Char(36)
  actorLabel  String       @db.VarChar(320)
  targetType  String?      @db.VarChar(64)
  targetId    String?      @db.VarChar(64)
  targetLabel String?      @db.VarChar(320)
  ipAddress   String?      @db.VarChar(45)
  userAgent   String?      @db.VarChar(512)
  requestId   String?      @db.VarChar(64)
  metadata    Json

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@index([tenantId, action, occurredAt])
  @@index([tenantId, actorId, occurredAt])
  @@map("audit_events")
}

/// Replay protection for non-idempotent POSTs carrying an `Idempotency-Key` header.
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Char(36)
  tenantId       String   @db.Char(36)
  key            String   @db.VarChar(128)
  identityId     String   @db.Char(36)
  requestHash    Bytes    @db.Binary(32)
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now()) @db.DateTime(3)
  expiresAt      DateTime @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ───────────── Phase 2: connectors, directory, job queue, machine identity ─────────────

enum ConnectorKind {
  microsoft_graph
}

enum ConnectorStatus {
  active
  disabled
}

enum SyncRunStatus {
  queued
  running
  succeeded
  failed
}

/// A link to an external directory. Non-secret settings live in `config`; the credential is
/// encrypted with AES-256-GCM under NF_DATA_KEY and is never returned by the API.
model Connector {
  id                  String          @id @default(uuid(7)) @db.Char(36)
  tenantId            String          @db.Char(36)
  kind                ConnectorKind
  name                String          @db.VarChar(120)
  status              ConnectorStatus @default(active)
  config              Json
  secretCiphertext    Bytes?          @db.VarBinary(2048)
  secretHint          String?         @db.VarChar(16)
  /// 0 = manual only.
  syncIntervalMinutes Int             @default(60)
  usersDeltaLink      String?         @db.Text
  groupsDeltaLink     String?         @db.Text
  lastSyncAt          DateTime?       @db.DateTime(3)
  lastSyncStatus      SyncRunStatus?
  createdById         String?         @db.Char(36)
  createdAt           DateTime        @default(now()) @db.DateTime(3)
  updatedAt           DateTime        @updatedAt @db.DateTime(3)
  version             Int             @default(0)

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  runs        SyncRun[]
  users       DirectoryUser[]
  groups      DirectoryGroup[]
  memberships DirectoryMembership[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([status, lastSyncAt])
  @@map("connectors")
}

model SyncRun {
  id                 String        @id @default(uuid(7)) @db.Char(36)
  tenantId           String        @db.Char(36)
  connectorId        String        @db.Char(36)
  status             SyncRunStatus @default(queued)
  /// manual | schedule
  trigger            String        @db.VarChar(16)
  /// full | delta (decided when the run starts)
  mode               String?       @db.VarChar(16)
  requestedById      String?       @db.Char(36)
  attempts           Int           @default(0)
  usersUpserted      Int           @default(0)
  usersRemoved       Int           @default(0)
  groupsUpserted     Int           @default(0)
  groupsRemoved      Int           @default(0)
  membershipsChanged Int           @default(0)
  error              String?       @db.VarChar(1000)
  startedAt          DateTime?     @db.DateTime(3)
  finishedAt         DateTime?     @db.DateTime(3)
  createdAt          DateTime      @default(now()) @db.DateTime(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connector Connector @relation(fields: [tenantId, connectorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, connectorId, createdAt])
  @@map("sync_runs")
}

/// Read-only copy of a user in an external directory. Not an Identity: it cannot sign in.
model DirectoryUser {
  id                String    @id @default(uuid(7)) @db.Char(36)
  tenantId          String    @db.Char(36)
  connectorId       String    @db.Char(36)
  externalId        String    @db.VarChar(64)
  userPrincipalName String    @db.VarChar(320)
  mail              String?   @db.VarChar(320)
  displayName       String    @db.VarChar(256)
  jobTitle          String?   @db.VarChar(128)
  department        String?   @db.VarChar(128)
  accountEnabled    Boolean   @default(true)
  deletedAt         DateTime? @db.DateTime(3)
  syncedAt          DateTime  @db.DateTime(3)
  createdAt         DateTime  @default(now()) @db.DateTime(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connector Connector @relation(fields: [tenantId, connectorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, connectorId, externalId])
  @@index([tenantId, displayName])
  @@index([tenantId, connectorId, syncedAt])
  @@map("directory_users")
}

model DirectoryGroup {
  id              String    @id @default(uuid(7)) @db.Char(36)
  tenantId        String    @db.Char(36)
  connectorId     String    @db.Char(36)
  externalId      String    @db.VarChar(64)
  displayName     String    @db.VarChar(256)
  description     String?   @db.VarChar(1024)
  mail            String?   @db.VarChar(320)
  securityEnabled Boolean   @default(false)
  mailEnabled     Boolean   @default(false)
  groupTypes      Json
  deletedAt       DateTime? @db.DateTime(3)
  syncedAt        DateTime  @db.DateTime(3)
  createdAt       DateTime  @default(now()) @db.DateTime(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connector Connector @relation(fields: [tenantId, connectorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, connectorId, externalId])
  @@index([tenantId, displayName])
  @@index([tenantId, connectorId, syncedAt])
  @@map("directory_groups")
}

/// Membership by external id, so a member may arrive before (or without) its user/group row.
model DirectoryMembership {
  id               String   @id @default(uuid(7)) @db.Char(36)
  tenantId         String   @db.Char(36)
  connectorId      String   @db.Char(36)
  groupExternalId  String   @db.VarChar(64)
  memberExternalId String   @db.VarChar(64)
  /// user | group | other
  memberType       String   @db.VarChar(16)
  syncedAt         DateTime @db.DateTime(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  connector Connector @relation(fields: [tenantId, connectorId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, connectorId, groupExternalId, memberExternalId])
  @@index([tenantId, connectorId, memberExternalId])
  @@index([tenantId, connectorId, syncedAt])
  @@map("directory_memberships")
}

enum JobStatus {
  queued
  running
  succeeded
  dead
}

/// Durable job queue (ADR 0008). Claimed with SELECT … FOR UPDATE SKIP LOCKED plus a lease;
/// when a worker dies its lease expires and the job runs again. `activeKey` is unique while
/// a job is queued or running (e.g. one sync per connector) and cleared when it finishes.
model Job {
  id          String    @id @default(uuid(7)) @db.Char(36)
  tenantId    String    @db.Char(36)
  type        String    @db.VarChar(64)
  payload     Json
  status      JobStatus @default(queued)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @db.DateTime(3)
  lockedBy    String?   @db.VarChar(64)
  lockedUntil DateTime? @db.DateTime(3)
  lastError   String?   @db.VarChar(2000)
  activeKey   String?   @unique @db.VarChar(128)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)
  finishedAt  DateTime? @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
  @@index([status, tenantId])
  @@index([tenantId, createdAt])
  @@map("jobs")
}

enum ServicePrincipalStatus {
  active
  disabled
}

/// Machine identity for connectors and automation (OAuth 2.0 client credentials).
model ServicePrincipal {
  id          String                 @id @default(uuid(7)) @db.Char(36)
  tenantId    String                 @db.Char(36)
  name        String                 @db.VarChar(120)
  description String                 @db.VarChar(500)
  clientId    String                 @unique @db.VarChar(64)
  /// Subset of MACHINE_PERMISSIONS from @nf/contracts.
  permissions Json
  status      ServicePrincipalStatus @default(active)
  createdById String?                @db.Char(36)
  lastUsedAt  DateTime?              @db.DateTime(3)
  createdAt   DateTime               @default(now()) @db.DateTime(3)
  updatedAt   DateTime               @updatedAt @db.DateTime(3)
  version     Int                    @default(0)

  tenant  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  secrets ServicePrincipalSecret[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("service_principals")
}

/// Client secrets are 256-bit random values; only their SHA-256 is stored. Several may be
/// valid at once, so a secret can be rotated without downtime.
model ServicePrincipalSecret {
  id                 String    @id @default(uuid(7)) @db.Char(36)
  tenantId           String    @db.Char(36)
  servicePrincipalId String    @db.Char(36)
  secretHash         Bytes     @unique @db.Binary(32)
  hint               String    @db.VarChar(8)
  expiresAt          DateTime  @db.DateTime(3)
  revokedAt          DateTime? @db.DateTime(3)
  lastUsedAt         DateTime? @db.DateTime(3)
  createdAt          DateTime  @default(now()) @db.DateTime(3)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  servicePrincipal ServicePrincipal @relation(fields: [tenantId, servicePrincipalId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, servicePrincipalId])
  @@map("service_principal_secrets")
}

// ───────────── Phase 2b: per-tenant single sign-on ─────────────

enum IdpEnforcement {
  optional
  required
}

/// A tenant's own OpenID Connect provider. It can only sign people in to this tenant.
/// The client secret is sealed with NF_DATA_KEY (AES-256-GCM) and never returned.
model TenantIdentityProvider {
  id                   String         @id @default(uuid(7)) @db.Char(36)
  tenantId             String         @unique @db.Char(36)
  issuer               String         @db.VarChar(512)
  clientId             String         @db.VarChar(255)
  secretCiphertext     Bytes          @db.VarBinary(2048)
  secretHint           String         @db.VarChar(16)
  requireEmailVerified Boolean        @default(true)
  enforcement          IdpEnforcement @default(optional)
  createdById          String?        @db.Char(36)
  createdAt            DateTime       @default(now()) @db.DateTime(3)
  updatedAt            DateTime       @updatedAt @db.DateTime(3)
  version              Int            @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_identity_providers")
}

// ───────────── Phase 2c: SCIM 2.0 provisioning ─────────────

/// Bearer token a provisioning client (Entra ID, Okta) uses for /api/scim/v2. 256-bit random;
/// only its SHA-256 is stored. Scoped to one tenant.
model ScimToken {
  id          String    @id @default(uuid(7)) @db.Char(36)
  tenantId    String    @db.Char(36)
  name        String    @db.VarChar(120)
  tokenHash   Bytes     @unique @db.Binary(32)
  hint        String    @db.VarChar(8)
  expiresAt   DateTime  @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  lastUsedAt  DateTime? @db.DateTime(3)
  createdById String?   @db.Char(36)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("scim_tokens")
}

// ───────────── Phase 2d: Linux server agent ─────────────

enum ServerLifecycle {
  active
  retired
}

/// Lets a new server enrol its agent. Shown once; only its SHA-256 is stored.
model AgentEnrollmentKey {
  id          String    @id @default(uuid(7)) @db.Char(36)
  tenantId    String    @db.Char(36)
  name        String    @db.VarChar(120)
  keyHash     Bytes     @unique @db.Binary(32)
  hint        String    @db.VarChar(8)
  uses        Int       @default(0)
  maxUses     Int?
  expiresAt   DateTime  @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  createdById String?   @db.Char(36)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("agent_enrollment_keys")
}

/// A Linux server reporting through the agent. Inventory is the latest snapshot.
model Server {
  id             String          @id @default(uuid(7)) @db.Char(36)
  tenantId       String          @db.Char(36)
  hostname       String          @db.VarChar(253)
  /// /etc/machine-id: stable across reboots and hostname changes.
  machineId      String          @db.Char(32)
  lifecycle      ServerLifecycle @default(active)
  /// SHA-256 of the agent's bearer token; replaced on re-enrolment, cleared on retirement.
  agentTokenHash Bytes?          @unique @db.Binary(32)
  agentVersion   String?         @db.VarChar(64)
  enrolledViaKey String?         @db.Char(36)
  inventory      Json?
  packages       Json?
  packagesHash   String?         @db.VarChar(64)
  packageCount   Int             @default(0)
  lastSeenAt     DateTime?       @db.DateTime(3)
  enrolledAt     DateTime        @default(now()) @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @db.DateTime(3)
  version        Int             @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, machineId])
  @@index([tenantId, hostname])
  @@map("servers")
}
